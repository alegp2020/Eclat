# Environment Variables Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env file to version control

# Contact Information
CONTACT_EMAIL=info@eventoseclat.com
WHATSAPP_PHONE=34602719265

# FormSubmit Configuration
FORMSUBMIT_ENDPOINT=https://formsubmit.co/info@eventoseclat.com
FORMSUBMIT_SUBJECT=Nuevo mensaje del formulario de contacto Éclat

# Social Media
INSTAGRAM_URL=https://www.instagram.com/eventos_eclat.oficial/

# Cookie Configuration
COOKIE_EXPIRY_DAYS=365
COOKIE_CONSENT_VERSION=1.0

# Security
ENABLE_ANALYTICS=false
ENABLE_TRACKING=false